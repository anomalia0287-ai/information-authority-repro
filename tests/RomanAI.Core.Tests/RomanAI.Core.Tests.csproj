<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\tools\RomanAI.Headless\HeadlessScenarioRunner.cs" Link="Headless\HeadlessScenarioRunner.cs" />
    <Compile Include="..\..\tools\RomanAI.Headless\ValidationScenarioSet.cs" Link="Headless\ValidationScenarioSet.cs" />
    <Compile Include="..\..\tools\RomanAI.Headless\PaperExperimentRunner.cs" Link="Headless\PaperExperimentRunner.cs" />
    <Compile Include="..\..\Romana\Assets\Scripts\RomanAI\Core\*.cs" Link="UnityCore\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RomanAI.Core\HumanPerformance\*.cs" Link="HumanPerformance\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\RomanAI.Headless\validation_scenarios_manifest.json" Link="validation_scenarios_manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\RomanAI.Headless\paper_heldout_manifest.json" Link="paper_heldout_manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\RomanAI.Headless\paper_broader_manifest.json" Link="paper_broader_manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
